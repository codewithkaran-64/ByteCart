# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file to GitHub.

# Local MongoDB:
#   MONGODB_URI=mongodb://127.0.0.1:27017/bytecart
# MongoDB Atlas (cloud, free tier):
#   MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/bytecart
MONGODB_URI=mongodb://127.0.0.1:27017/bytecart

# Any long random string. Used to sign login tokens (JWT).
JWT_SECRET=change-this-to-a-long-random-secret-key

# Port the server runs on
PORT=3000

# Stripe TEST MODE keys (from https://dashboard.stripe.com/test/apikeys)
# These start with "pk_test_" and "sk_test_" - safe to use for development,
# no real card is ever charged in test mode.
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# Base URL of your running site, used to build Stripe's success/cancel redirect links.
# Keep this as-is for local development.
CLIENT_URL=http://localhost:3000
